generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. USER TABLE
model User {
  id            String         @id
  email         String?        @unique
  password      String?
  name          String
  //age           Int?
  birthDate     DateTime?
  gender        String?
  role          String
  coachId       String?
  totpSecret    String?
  totpEnabled   Boolean        @default(false)
  createdAt     DateTime       @default(now())

  // Relations
  coach         User?          @relation("CoachToClient", fields: [coachId], references: [id])
  clients       User[]         @relation("CoachToClient")
  trainingMenus TrainingMenu[] @relation("AuthoredMenus")
  clientMenus   TrainingMenu[] @relation("ClientMenus")
  recaps        UserRecap[]
  activityLogs  ActivityLog[]

}

// 2. TRAINING MENU TABLE
model TrainingMenu {
  id            String         @id @default(cuid())
  name          String         @default("Custom Program")
  authorId      String
  clientId      String?
  exerciseList  Json
  createdAt     DateTime       @default(now())

  // Relations
  author        User           @relation("AuthoredMenus", fields: [authorId], references: [id]) 
  client        User?          @relation("ClientMenus", fields: [clientId], references: [id])
  recaps        UserRecap[]
}

// 3. USER RECAP TABLE
model UserRecap {
  id             String        @id @default(cuid())
  userId         String
  menuId         String?
  sessionSummary Json
  isCompleted    Boolean       @default(false)
  sessionDuration Int          @default(0)
  completedAt    DateTime      @default(now())
  mongodbId      String?       @unique

  // Relations
  user           User          @relation(fields: [userId], references: [id])
  menu           TrainingMenu? @relation(fields: [menuId], references: [id])
}

// 4. ACTIVITY LOGS TABLE
model ActivityLog {
  id            String         @id @default(cuid())
  userId        String
  timeStamp     DateTime       @default(now())
  status        String?
  confidence    String?
  details       Json?

  // Relations
  user          User           @relation(fields: [userId], references: [id])
}